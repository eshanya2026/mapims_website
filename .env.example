# --- 6. Outgoing Mail Server (SMTP) ---
# Gmail SMTP — create an App Password at https://myaccount.google.com/apppasswords
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="shreytech26@gmail.com"
SMTP_PASS="your-16-char-gmail-app-password"
SMTP_FROM="MAPIMS Hospitals <shreytech26@gmail.com>"

# Reserved Ports
# Frontend: 1004 | Backend: 2004 | MongoDB: 3004
PORT="1004"
FRONTEND_PORT="1004"
BACKEND_PORT="2004"
MONGODB_PORT="3004"

# Local dev: http://localhost:1004
# Production (Vercel): https://mapims-website.vercel.app
SITE_URL="http://localhost:1004"
BACKEND_URL="http://localhost:2004"

# Local MongoDB container/service (maps to port 3004):
# MONGODB_URI="mongodb://localhost:3004/mapims-cms"

# Vercel Blob — required on Vercel for CMS image/resume uploads
# Vercel dashboard → Storage → Create Blob → connect to this project (sets token/store automatically)
# BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."
# BLOB_STORE_ID="store_..."

# OpenRouter AI — live chat assistant (https://openrouter.ai)
OPENROUTER_API_KEY="sk-or-v1-your-openrouter-api-key-here"
