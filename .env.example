# =============================================================================
# EMAIL RECIPIENTS & CONTACT SETTINGS
# (Change any email address below to route emails to different recipients)
# =============================================================================

# --- 1. Insurance Desk ---
# Where patient insurance verification & queries are emailed:
INSURANCE_NOTIFICATION_EMAIL="Insurance@mapims.org"
# Email displayed on insurance pages & contact links:
NEXT_PUBLIC_INSURANCE_EMAIL="Insurance@mapims.org"
# Direct insurance desk phone number:
INSURANCE_CONTACT_PHONE="9499059970"
NEXT_PUBLIC_INSURANCE_PHONE="9499059970"

# --- 2. Hospital General Inquiries & Patient Desk ---
# Where website contact form & international patient inquiries are sent:
INQUIRY_NOTIFICATION_EMAIL="contact@mapims.edu.in"
