HOSPITAL_CONTACT_EMAIL="contact@mapims.edu.in"
NEXT_PUBLIC_HOSPITAL_EMAIL="contact@mapims.edu.in"
# Hospital phone numbers:
HOSPITAL_CONTACT_PHONE="+91 94990 59966"
NEXT_PUBLIC_HOSPITAL_PHONE="+91 94990 59966"
INTERNATIONAL_DESK_PHONE="1800 599 0999"
NEXT_PUBLIC_TOLL_FREE_PHONE="1800 599 0999"

# --- 3. HR & Careers Desk ---
# Where job applications and resumes are sent:
HR_NOTIFICATION_EMAIL="shreytech26@gmail.com"
# HR contact email shown to candidates in emails & website:
HR_CONTACT_EMAIL="contact@mapims.online"
NEXT_PUBLIC_HR_CONTACT_EMAIL="contact@mapims.online"
HR_CONTACT_PHONE="+91 94990 59959"

# --- 4. Newsletter Communications ---
