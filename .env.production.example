# ==============================================================================
# MAPIMS Website (Adhiparasakthi Hospitals) - Production Environment Configuration
# ==============================================================================

# MongoDB Connection
# Option A: Connect to local Docker MongoDB container (recommended for single-server VPS):
MONGODB_URI="mongodb://mongo:27017/mapims-cms"
# Option B: Connect to MongoDB Atlas (cloud cluster):
# MONGODB_URI="mongodb+srv://USER:PASSWORD@cluster0.xxx.mongodb.net/mapims-cms?appName=Cluster0"

MONGODB_DB_NAME="mapims-cms"

# Security & Authentication
# Generate a strong 32+ character random secret (e.g., openssl rand -base64 32):
AUTH_SECRET="generate-a-strong-random-auth-secret-key-here"

# CMS Initial Admin Credentials (used by scripts/seed.ts)
ADMIN_EMAIL="admin@mapims.edu.in"
ADMIN_PASSWORD="change-me-to-a-secure-production-password"

# HR notifications (job application form submissions)
HR_NOTIFICATION_EMAIL="hr@mapims.edu.in"

# Reserved Ports & Host Binding
PORT="1004"
FRONTEND_PORT="1004"
BACKEND_PORT="2004"
MONGODB_PORT="3004"

# Host IP binding for MongoDB (Use 127.0.0.1 to avoid exposing Mongo to the public internet)
MONGODB_HOST_BIND="127.0.0.1"

# Production URLs (Update to your live domain)
SITE_URL="https://mapims.edu.in"
BACKEND_URL="https://mapims.edu.in"

# SMTP Email Configuration (Transactional Emails & Notifications)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="notifications@mapims.edu.in"
SMTP_PASS="your-app-specific-password"
SMTP_FROM="MAPIMS Hospitals <notifications@mapims.edu.in>"

# AI Live Chat Assistant (OpenRouter)
OPENROUTER_API_KEY="sk-or-v1-your-key-here"
OPENROUTER_MODEL="meta-llama/llama-3.3-70b-instruct"

# Vercel Blob (Optional - only needed if storing uploads in Vercel Blob instead of local Docker volume)
# BLOB_READ_WRITE_TOKEN=""
# BLOB_STORE_ID=""
